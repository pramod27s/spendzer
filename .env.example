# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# Postgres from docker-compose (host port 5433 to avoid clashing with a local Postgres)
DATABASE_URL=postgresql+asyncpg://spendzer:spendzer@localhost:5433/spendzer

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Must be true in production (HTTPS). false lets the refresh cookie work on http://localhost.
COOKIE_SECURE=false

# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

RATE_LIMIT_ENABLED=true
